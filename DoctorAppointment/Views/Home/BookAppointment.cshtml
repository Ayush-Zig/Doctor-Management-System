<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>

    function onDateChange() {
        let selectedDate = document.getElementById('booking_date').value;
        let date = new Date(selectedDate);
        let DayOfWeek = date.getDay();
        $.ajax({
            url: '/Home/GetSlot',
            type: 'GET',
            dataType: 'JSON',
            data: { DayOfWeek: DayOfWeek },
            success: function (response) {
                BindSlots(response);
            },
            error: function (xhr, status, error) {
                alert("An error occurred while fetching slots. Please try again.");
            }
        });
    }


    $(document).ready(function () {

        let SelectedDate = $('#booking_date').val();
        let date = new Date(SelectedDate);
        let DayOfWeek = date.getDay();

        $.ajax({
            url: '/Home/GetSlot',
            type: "GET",
            data: { DayOfWeek: DayOfWeek },
            dataType: "json",
            success: function (response) {
                BindSlots(response);
            },
            error: function (xhr, status, error) {
                alert("An error occurred while fetching slots. Please try again.");
            }
        });
    });



    function BindSlots(response) {
        if (response.length === 0) {
            $('.slot-outer-box').empty();
            $('#no_slot').show();
        } else {
            $('#no_slot').hide();
            $('.slot-outer-box').empty();
            response.forEach(slot => {
                let slotHTML = `
                <div class="slot-box badge bg-primary-soft text-primary py-2 px-3 mb-2">
                    <input type="radio" id="${slot.SlotId}" value="${slot.SlotId}" name="SlotId" required/>
                    <label for="${slot.SlotId}">${slot.StartTime} - ${slot.EndTime}</label>
                </div>
            `;
                $('.slot-outer-box').append(slotHTML);
            });
        }
    }



</script>
