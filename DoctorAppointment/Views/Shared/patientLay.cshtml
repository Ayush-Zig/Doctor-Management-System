@model DoctorAppointment.Models.UserModel
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Appointment Solution</title>

    <link href="~/content/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/content/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/content/bootstrap-datetimepicker.min.css" rel="stylesheet" />
    <link href="~/content/custom.css" rel="stylesheet" />
    <style>
        .owl-carousel {
            display: block;
        }
        .content {
            padding: 0;
        }
     

    </style>
</head>

<body>

    <div class="main-wrapper">


        <div class="breadcrumb-bar-two" style="position: relative; overflow: hidden;">
            <video autoplay loop muted style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;">
                <source src="~/content/video/6db2dc2a4785c0f4921675ae164f9873-720p-preview.mp4" type="video/mp4">
                Your browser does not support HTML5 video.
            </video>

            <div class="container" style="position: relative; z-index: 2;">
                <div class="row align-items-center inner-banner">
                    <div class="col-md-12 col-12 text-center">
                        <h2 class="breadcrumb-title" style="color: white; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);">Patient Dashboard</h2>
                        <nav aria-label="breadcrumb" class="page-breadcrumb">
                            <ol class="breadcrumb" style="justify-content: center;">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" style="color: white;">Home</a></li>
                                <li class="breadcrumb-item" aria-current="page" style="color: white;">Patient Dashboard</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

       

        <div class="content">
            <div class="breadcrumb-bar-two" style="position: relative; overflow: hidden; height: 100vh;">
                <!-- Ensures full height -->
                <video autoplay loop muted style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1;">
                    <!-- Negative z-index -->
                    <source src="~/content/video/istock_video_1732988194093.mp4" type="video/mp4">
                    Your browser does not support HTML5 video.
                </video>

                <div class="container" style="position: relative; z-index: 1;">
                    <!-- Ensure content is above video -->
                    <div class="row">
                        <div class="col-lg-4 col-xl-3 theiaStickySidebar transparent-background">
                            <div class="profile-sidebar patient-sidebar profile-sidebar-new" style="background-color: transparent;">
                                <div class="widget-profile pro-widget-content" style="background-color: transparent !important">
                                    <div class="profile-info-widget">
                                        <a href="" class="booking-doc-img">
                                            <img src="@Session["ProfileImagePath"]" alt="User Image">
                                        </a>
                                        <div class="profile-det-info">
                                            <h3><a href="">@Session["UserName"]</a></h3>
                                            <div class="patient-details">
                                                <h5 class="mb-0">Patient ID : @Session["PatientId"]</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="dashboard-widget">
                                    <nav class="dashboard-menu">
                                        <ul>
                                            <li class="active">
                                                <a href="@Url.Action("MyAppointment", "Patient")">
                                                    <i class="fa-solid fa-calendar-days"></i>
                                                    <span>My Appointments</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="@Url.Action("BookAppointment", "Home")">
                                                    <i class="fa-solid fa-user-pen"></i>
                                                    <span>Book Appointment</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="@Url.Action("UpdateRegister", "Account")">
                                                    <i class="fa-solid fa-key"></i>
                                                    <span>Update Profile</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="@Url.Action("Logout", "Account")">
                                                    <i class="fa-solid fa-calendar-check"></i>
                                                    <span>Logout</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        </div>
                        @RenderBody() <!-- Render the main content -->
                    </div>
                </div>
            </div>
        </div>



























