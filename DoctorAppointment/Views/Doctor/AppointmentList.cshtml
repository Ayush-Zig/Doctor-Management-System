    function ChangeStatus(aptID) {
        // Fetch the value from the specific dropdown
        var StatusId = $("#status_" + aptID).val();

        if (StatusId == "0") {
            alert("Please select a valid status.");
            return;
        }

        $.ajax({
            url: '/Doctor/ChangeStatus',
            type: 'POST',
            data: {
                appointmentId: aptID,
                statusId: StatusId
            },
            success: function (response) {
                if (response.success) {
                    alert("Status updated successfully");
                    window.location.reload();
                } else {
                    alert("Failed to update status");
                }
            },
            error: function (xhr) {
                console.error("Error occurred:", xhr.responseText);
            }
        });
    }

</script>


