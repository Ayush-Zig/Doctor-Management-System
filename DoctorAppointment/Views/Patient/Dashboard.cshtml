
@model DoctorAppointment.Models.UserModel
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/patientLay.cshtml";
}

<div class="col-lg-8 col-xl-9">
    <div class="row">
        <div class="col-xl-5 d-flex">
            <div class="dashboard-main-col w-100"></div>
        </div>
        <div class="col-xl-7 d-flex">
            <div class="dashboard-main-col w-100">

                <div class="dashboard-card w-100">
                    <div class="dashboard-card-head">
                        <div class="header-title">
                            <h5>Patients Details</h5>
                        </div>
                        <div class="card-view-link">
                            <div class="owl-nav slide-nav2 text-end nav-control"></div>
                        </div>
                    </div>
                    <div class="dashboard-card-body">
                        <div class="past-appointments-slider owl-carousel">
                            <div class="appointment-dash-card past-appointment">

                                <div class="doctor-fav-list">
                                    <div class="doctor-info-profile">
                                        <div class="doctor-name-info">
                                            <div class="form-row mb-3">
                                                <!-- Input for Patient Name -->
                                                <div class="col" >
                                                    <label for="patientName" class="form-label">Patient Name</label>
                                                    <input type="text" id="patientName" class="form-control" value="@Session["UserName"]" style="background-color: transparent !important" readonly required>
                                                </div>

                                                <!-- Input for Email -->
                                                <div class="col">
                                                    <label for="patientEmail" class="form-label">Email</label>
                                                    <input type="email" id="patientEmail" class="form-control" value="@Session["Email"]" style="background-color: transparent !important" readonly required>
                                                </div>

                                                <!-- Input for Date of Birth -->
                                                <div class="col">
                                                    <label for="patientDOB" class="form-label">Date of Birth</label>
                                                    <input type="date" id="patientDOB" class="form-control" value="@Session["DateOfBirth"]" style="background-color: transparent !important" readonly required>
                                                </div>

                                                <!-- Input for Phone -->
                                                <div class="col">
                                                    <label for="patientPhone" class="form-label">Phone</label>
                                                    <input type="tel" id="patientPhone" class="form-control" value="@ViewBag.PhoneNumber" style="background-color: transparent !important" readonly required>
                                                </div>

                                                <!-- Input for Address -->
                                                <!--<div class="col">
                                                    <label for="patientAddress" class="form-label">Address</label>
                                                    <input type="text" id="patientAddress" class="form-control" value="@Session["Address"]" required>
                                                </div>-->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
